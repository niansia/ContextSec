{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/niansia/ContextSec/v0.4.0/benchmarks/external-review.schema.json",
  "title": "ContextSec Independent External Review Manifest",
  "type": "object",
  "required": ["$schema", "version", "status", "sampling_frame", "review_policy", "cases"],
  "properties": {
    "$schema": {"const": "https://raw.githubusercontent.com/niansia/ContextSec/v0.4.0/benchmarks/external-review.schema.json"},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["template", "complete"]},
    "sampling_frame": {
      "type": "object",
      "required": ["population", "selection_method", "inclusion_criteria", "exclusion_criteria", "freeze_date"],
      "properties": {
        "population": {"type": "string", "minLength": 1},
        "selection_method": {"type": "string", "minLength": 1},
        "inclusion_criteria": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "exclusion_criteria": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "freeze_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      },
      "additionalProperties": false
    },
    "review_policy": {
      "const": {
        "detector_implementers_excluded": true,
        "contextsec_contributors_excluded": true,
        "reviewers_label_before_tool_output": true,
        "reviewers_from_distinct_organizations": true,
        "adjudicator_independent_of_reviewers": true,
        "conflicts_disclosed": true,
        "disagreements_retained": true,
        "minimum_reviewers_per_case": 2
      }
    },
    "cases": {
      "type": "array",
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "complete"}}, "required": ["status"]},
      "then": {"properties": {"cases": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "labels": {
      "type": "object",
      "required": ["foundation", "baseline-web", "auth-session", "payments", "privacy-pii", "multi-tenant", "api-inbound", "external-api", "file-upload", "ai-rag-agent", "secrets-management", "cloud-iam-controlplane", "cicd-supply-chain", "third-party-saas-oauth", "support-admin-ops", "high-impact-transactions"],
      "properties": {
        "foundation": {"enum": ["required", "candidate", "inactive", "unknown"]},
        "baseline-web": {"enum": ["required", "candidate", "inactive", "unknown"]},
        "auth-session": {"enum": ["required", "candidate", "inactive", "unknown"]},
        "payments": {"enum": ["required", "candidate", "inactive", "unknown"]},
        "privacy-pii": {"enum": ["required", "candidate", "inactive", "unknown"]},
        "multi-tenant": {"enum": ["required", "candidate", "inactive", "unknown"]},
        "api-inbound": {"enum": ["required", "candidate", "inactive", "unknown"]},
        "external-api": {"enum": ["required", "candidate", "inactive", "unknown"]},
        "file-upload": {"enum": ["required", "candidate", "inactive", "unknown"]},
        "ai-rag-agent": {"enum": ["required", "candidate", "inactive", "unknown"]},
        "secrets-management": {"enum": ["required", "candidate", "inactive", "unknown"]},
        "cloud-iam-controlplane": {"enum": ["required", "candidate", "inactive", "unknown"]},
        "cicd-supply-chain": {"enum": ["required", "candidate", "inactive", "unknown"]},
        "third-party-saas-oauth": {"enum": ["required", "candidate", "inactive", "unknown"]},
        "support-admin-ops": {"enum": ["required", "candidate", "inactive", "unknown"]},
        "high-impact-transactions": {"enum": ["required", "candidate", "inactive", "unknown"]}
      },
      "additionalProperties": false
    },
    "annotator": {
      "type": "object",
      "required": ["reviewer_id", "implemented_detectors", "contextsec_contributor", "organization", "conflicts_of_interest", "expertise_class", "labels_frozen_at", "labels"],
      "properties": {
        "reviewer_id": {"type": "string", "minLength": 1},
        "implemented_detectors": {"const": false},
        "contextsec_contributor": {"const": false},
        "organization": {"type": "string", "minLength": 1},
        "conflicts_of_interest": {"const": []},
        "expertise_class": {"type": "string", "minLength": 1},
        "labels_frozen_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "labels": {"$ref": "#/$defs/labels"}
      },
      "additionalProperties": false
    },
    "consensus": {
      "type": "object",
      "required": ["labels", "adjudication_reason", "adjudicator_id", "adjudicator_implemented_detectors", "adjudicator_contextsec_contributor", "adjudicator_organization", "adjudicator_conflicts_of_interest"],
      "properties": {
        "labels": {"$ref": "#/$defs/labels"},
        "adjudication_reason": {"type": "string", "minLength": 1},
        "adjudicator_id": {"type": "string", "minLength": 1},
        "adjudicator_implemented_detectors": {"const": false},
        "adjudicator_contextsec_contributor": {"const": false},
        "adjudicator_organization": {"type": "string", "minLength": 1},
        "adjudicator_conflicts_of_interest": {"const": []}
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": ["id", "repository", "commit", "framework_group", "license_spdx", "license_evidence_url", "selection_rank", "sampling_reason", "frozen_at", "annotator_a", "annotator_b", "consensus"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
        "repository": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "framework_group": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.+-]{0,63}$"},
        "license_spdx": {"type": "string", "minLength": 1},
        "license_evidence_url": {"type": "string", "pattern": "^https://"},
        "selection_rank": {"type": "integer", "minimum": 1},
        "sampling_reason": {"type": "string", "minLength": 1},
        "frozen_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "annotator_a": {"$ref": "#/$defs/annotator"},
        "annotator_b": {"$ref": "#/$defs/annotator"},
        "consensus": {"$ref": "#/$defs/consensus"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
