{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/niansia/ContextSec/v0.4.0/benchmarks/holdout-predictions.schema.json",
  "title": "ContextSec External Holdout Predictions",
  "type": "object",
  "required": ["$schema", "version", "status", "tool", "cases"],
  "properties": {
    "$schema": {"const": "https://raw.githubusercontent.com/niansia/ContextSec/v0.4.0/benchmarks/holdout-predictions.schema.json"},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["template", "complete"]},
    "tool": {
      "type": "object",
      "required": ["tool_version", "schema_version", "git_commit", "detector_version", "checker_version", "detector_model_digest", "routing_model_digest", "checker_model_digest", "catalog_digest", "composition_digest", "support_matrix_digest"],
      "properties": {
        "tool_version": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "minLength": 1},
        "git_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "detector_version": {"type": "string", "minLength": 1},
        "checker_version": {"type": "string", "minLength": 1},
        "detector_model_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "routing_model_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "checker_model_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "catalog_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "composition_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "support_matrix_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "repository", "commit", "profile"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
          "repository": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
          "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
          "profile": {"$ref": "https://raw.githubusercontent.com/niansia/ContextSec/v0.4.0/.agents/skills/contextsec/references/security-profile.schema.json"}
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "complete"}}, "required": ["status"]},
      "then": {"properties": {"cases": {"minItems": 1}}}
    }
  ],
  "additionalProperties": false
}
