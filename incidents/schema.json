{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/niansia/ContextSec/v0.3.2/incidents/schema.json",
  "title": "ContextSec incident-to-control map",
  "type": "object",
  "required": ["schema_version", "id", "event_date", "title", "investigation_status", "sources", "confirmed_facts", "inferences", "failure_patterns", "trust_boundaries", "contexts", "controls", "control_hypotheses", "regression"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "event_date": {"type": "string", "format": "date"},
    "title": {"type": "string", "minLength": 1},
    "investigation_status": {"enum": ["ongoing", "published", "advisory"]},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["publisher", "url", "source_date"], "properties": {"publisher": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "source_date": {"type": "string", "format": "date"}}, "additionalProperties": false}},
    "confirmed_facts": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "inferences": {"type": "array", "items": {"type": "string"}},
    "failure_patterns": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "trust_boundaries": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "contexts": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "controls": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]+(?:-[A-Z]+)+-[0-9]{3}$"}, "minItems": 1, "uniqueItems": true},
    "control_hypotheses": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "regression": {"type": "object", "required": ["fixture", "expected_routes", "mutation"], "properties": {"fixture": {"type": "string"}, "expected_routes": {"type": "array", "items": {"type": "string"}}, "mutation": {"type": "string"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
