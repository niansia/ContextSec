model Organization {
  id       String    @id
  users    User[]
  invoices Invoice[]
}

model User {
  id             String       @id
  email          String       @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Invoice {
  id             String       @id
  billingAddress String
  objectKey      String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
}
