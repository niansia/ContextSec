{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/niansia/ContextSec/v0.4.0/.agents/skills/contextsec/references/catalog.schema.json",
  "title": "ContextSec pack and control catalog",
  "type": "object",
  "required": ["schema_version", "capabilities", "packs"],
  "properties": {
    "schema_version": {"const": "0.4.0"},
    "capabilities": {"$ref": "#/$defs/capabilities"},
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "claim", "dependencies", "reference", "activation", "controls"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
          "claim": {"type": ["string", "null"]},
          "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "reference": {"type": "string", "minLength": 1},
          "activation": {"type": "string", "minLength": 1},
          "controls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "severity", "blocking", "invariant", "required_verification"],
              "properties": {
                "id": {"type": "string", "pattern": "^[A-Z]+(?:-[A-Z]+)+-[0-9]{3}$"},
                "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
                "blocking": {"type": "boolean"},
                "applies_when": {
                  "oneOf": [
                    {"type": "object", "required": ["all"], "properties": {"all": {"$ref": "#/$defs/capabilities"}}, "additionalProperties": false},
                    {"type": "object", "required": ["any"], "properties": {"any": {"$ref": "#/$defs/capabilities"}}, "additionalProperties": false}
                  ]
                },
                "invariant": {"type": "string", "minLength": 1},
                "required_verification": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"}
    }
  },
  "additionalProperties": false
}
