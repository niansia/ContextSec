{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/niansia/ContextSec/v0.3.1/.agents/skills/contextsec/references/control-checks.schema.json",
  "title": "ContextSec deterministic control checks",
  "type": "object",
  "required": ["schema_version", "subject", "active_packs", "findings", "finding_summary", "limitations"],
  "properties": {
    "schema_version": {"const": "0.3.1"},
    "subject": {
      "type": "object",
      "required": ["repository", "subject_revision", "source_inventory_digest", "decision_model_digest", "checker_version", "profile_coverage", "profile_language_support", "checker_coverage", "checker_input_hash"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "subject_revision": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "source_inventory_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "decision_model_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "checker_version": {"type": "string", "minLength": 1},
        "profile_coverage": {"enum": ["complete", "partial"]},
        "profile_language_support": {"enum": ["supported", "partial", "unsupported"]},
        "checker_coverage": {
          "type": "object",
          "required": ["traversal", "language_support", "checker_support", "match_enumeration"],
          "properties": {
            "traversal": {"enum": ["complete", "partial"]},
            "language_support": {"enum": ["supported", "partial", "unsupported"]},
            "checker_support": {"enum": ["complete", "partial"]},
            "match_enumeration": {"enum": ["complete", "mixed_first_only", "first_only"]}
          },
          "additionalProperties": false
        },
        "checker_input_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "active_packs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "checker", "control_ids", "status", "severity", "title", "impact", "attack_path", "evidence", "method"],
        "properties": {
          "id": {"type": "string", "pattern": "^finding-[a-z0-9-]+$"},
          "checker": {
            "type": "object",
            "required": ["id", "version"],
            "properties": {
              "id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
              "version": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "control_ids": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]+(?:-[A-Z]+)+-[0-9]{3}$"}, "minItems": 1, "uniqueItems": true},
          "status": {"enum": ["verified", "failed", "unknown", "not_applicable"]},
          "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
          "title": {"type": "string", "minLength": 1},
          "impact": {"type": "string", "minLength": 1},
          "attack_path": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "object",
            "required": ["path", "locator", "evidence_id", "location_id", "content_digest", "fingerprint", "subject_revision"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "locator": {"type": "string", "pattern": "^line:[1-9][0-9]*$"},
              "evidence_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
              "location_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
              "content_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
              "fingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
              "subject_revision": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
            },
            "additionalProperties": false
          },
          "method": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "finding_summary": {
      "type": "object",
      "required": ["failed_findings", "unknown_findings", "verified_findings", "total_findings"],
      "properties": {
        "failed_findings": {"type": "integer", "minimum": 0},
        "unknown_findings": {"type": "integer", "minimum": 0},
        "verified_findings": {"type": "integer", "minimum": 0},
        "total_findings": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "limitations": {"type": "array", "items": {"type": "string"}, "minItems": 1}
  },
  "additionalProperties": false
}
