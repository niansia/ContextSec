{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextsec.dev/schemas/security-profile-0.2.1.json",
  "title": "ContextSec Security Profile",
  "$defs": {
    "pack": {
      "enum": ["foundation", "baseline-web", "auth-session", "payments", "privacy-pii", "multi-tenant", "api-inbound", "external-api", "file-upload", "ai-rag-agent", "secrets-management", "cloud-iam-controlplane", "cicd-supply-chain", "third-party-saas-oauth", "support-admin-ops", "high-impact-transactions"]
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "coverage",
    "observations",
    "claims",
    "capabilities",
    "routing",
    "required_packs",
    "candidate_packs",
    "contradictions",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "0.2.1"},
    "subject": {
      "type": "object",
      "required": ["repository", "subject_revision", "source_inventory_digest", "decision_model_digest", "files_scanned", "files_skipped", "bytes_scanned"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "subject_revision": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "source_inventory_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "decision_model_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "files_scanned": {"type": "integer", "minimum": 0},
        "files_skipped": {"type": "integer", "minimum": 0},
        "bytes_scanned": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": ["status", "entries_seen", "production_files_considered", "skip_counts", "limits"],
      "properties": {
        "status": {"enum": ["complete", "partial"]},
        "entries_seen": {"type": "integer", "minimum": 0},
        "production_files_considered": {"type": "integer", "minimum": 0},
        "skip_counts": {
          "type": "object",
          "required": ["non_production_scope", "file_size_limit", "total_byte_limit", "stat_error", "read_error", "binary", "invalid_encoding", "invalid_manifest"],
          "properties": {
            "non_production_scope": {"type": "integer", "minimum": 0},
            "file_size_limit": {"type": "integer", "minimum": 0},
            "total_byte_limit": {"type": "integer", "minimum": 0},
            "stat_error": {"type": "integer", "minimum": 0},
            "read_error": {"type": "integer", "minimum": 0},
            "binary": {"type": "integer", "minimum": 0},
            "invalid_encoding": {"type": "integer", "minimum": 0},
            "invalid_manifest": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "limits": {
          "type": "object",
          "required": ["max_entries", "max_files", "max_file_bytes", "max_total_bytes"],
          "properties": {
            "max_entries": {"type": "integer", "minimum": 1},
            "max_files": {"type": "integer", "minimum": 1},
            "max_file_bytes": {"type": "integer", "minimum": 1},
            "max_total_bytes": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "pack", "claim", "scope", "confidence", "detector", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^obs-[a-f0-9]{12}$"},
          "kind": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "pack": {"$ref": "#/$defs/pack"},
          "claim": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"},
          "scope": {"enum": ["production", "test", "documentation"]},
          "confidence": {"enum": ["high", "medium", "low"]},
          "detector": {
            "type": "object",
            "required": ["id", "version"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
              "version": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "evidence": {
            "type": "object",
            "required": ["path", "locator", "evidence_id", "location_id", "content_digest", "fingerprint", "subject_revision"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "locator": {"type": "string", "minLength": 1},
              "evidence_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
              "location_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
              "content_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
              "fingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
              "subject_revision": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "pack", "state", "source", "inference_confidence", "evidence_refs"],
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"},
          "pack": {"$ref": "#/$defs/pack"},
          "state": {"enum": ["present", "absent", "unknown", "contradicted"]},
          "source": {"enum": ["inferred", "declared", "combined"]},
          "inference_confidence": {"enum": ["high", "medium", "low", "none"]},
          "evidence_refs": {
            "type": "array",
            "items": {"type": "string", "pattern": "^obs-[a-f0-9]{12}$"},
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "state", "evidence_refs", "reason"],
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"},
          "state": {"enum": ["present", "not_observed", "unknown"]},
          "evidence_refs": {"type": "array", "items": {"type": "string", "pattern": "^obs-[a-f0-9]{12}$"}, "uniqueItems": true},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "routing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pack", "state", "reasons", "dependencies"],
        "properties": {
          "pack": {"$ref": "#/$defs/pack"},
          "state": {"enum": ["required", "candidate", "inactive", "unknown"]},
          "reasons": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "dependencies": {"type": "array", "items": {"$ref": "#/$defs/pack"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    },
    "required_packs": {"type": "array", "items": {"$ref": "#/$defs/pack"}, "uniqueItems": true},
    "candidate_packs": {"type": "array", "items": {"$ref": "#/$defs/pack"}, "uniqueItems": true},
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "declared", "observed", "message"],
        "properties": {
          "claim": {"type": "string"},
          "declared": {"enum": ["present", "absent"]},
          "observed": {"enum": ["present", "unknown"]},
          "message": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
