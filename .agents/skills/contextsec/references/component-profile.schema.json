{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/niansia/ContextSec/v0.4.0/.agents/skills/contextsec/references/component-profile.schema.json",
  "title": "ContextSec Component Profile",
  "type": "object",
  "required": ["$schema", "schema_version", "artifact_type", "artifact_options", "subject", "component_model", "components", "flows", "limitations"],
