    "schema_version": {"const": "0.4.0"},
    "artifact_type": {"const": "component-profile"},
    "artifact_options": {"type": "object"},
    "subject": {"type": "object"},
    "component_model": {"$ref": "https://raw.githubusercontent.com/niansia/ContextSec/v0.4.0/.agents/skills/contextsec/references/component-model.schema.json"},
    "components": {"type": "array", "minItems": 1},
    "flows": {"type": "array"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
